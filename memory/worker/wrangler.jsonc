{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autonomous-dev-memory",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "MEMORY", "class_name": "MemoryStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MemoryStore"] }
  ]
}
